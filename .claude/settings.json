{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "test-strategist",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/open-review.sh"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".claude/test-plans/decisions.json",
        "hooks": [
          { "type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/on-review-completed.sh" }
        ]
      }
    ]
  }
}