{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "test-strategist",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/open-review.sh"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".claude/test-plans/decisions.json",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/on-review-completed.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "sdd-engineering@dev-digest-ai-marketplace": true,
    "research-tools@dev-digest-ai-marketplace": true,
    "architecture-review@dev-digest-ai-marketplace": true,
    "engineering-paved-path@dev-digest-ai-marketplace": true
  },
  "extraKnownMarketplaces": {
    "dev-digest-ai-marketplace": {
      "source": {
        "source": "github",
        "repo": "marynabieliaieva/dev-ai-harness-marketplace"
      }
    }
  }
}
